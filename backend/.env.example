# Copy to .env and set your own provider credentials. Never commit .env.
# Model provider must support the Anthropic-compatible messages protocol.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
REDIS_URL=redis://127.0.0.1:6387/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8999
CHROMA_PERSIST_DIRECTORY=./data/chroma
ECHOMIND_WORKBENCH_DB=./data/workbench.sqlite3
API_HOST=127.0.0.1
API_PORT=8010
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
LOG_LEVEL=INFO
EVAL_BASELINE_PATH=./data/eval/baseline.json
# Optional OpenAI-compatible embedding provider. Empty key uses Chroma default
# MiniLM embeddings (first use may download a model). Never mix dimensions in one collection.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
